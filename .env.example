# LearnHub Academy (producción)
# Copia este archivo como ".env" en esta misma carpeta y ajusta los valores.
# El archivo ".env" NO se sube a git.

# Nombre completo con el que se abrirá la plataforma (debe tener un registro DNS hacia tu servidor)
ACADEMY_HOST=academy.tudominio.com

# Base de datos PostgreSQL
DB_NAME=learnhub
DB_USER=learnhub_user
DB_PASSWORD=cambia-esta-clave-por-una-segura

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con:  openssl rand -hex 32
JWT_SECRET=
# Duración de la sesión en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION=86400000

# Memoria máxima de Java. Si tu servidor tiene poca RAM (1 GB), baja el valor (ej. -Xmx256m)
API_JAVA_OPTS=-Xmx384m
