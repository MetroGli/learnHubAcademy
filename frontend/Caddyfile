# Dentro del contenedor Caddy solo habla HTTP (:80);
# Traefik se encarga del dominio y del certificado HTTPS.
:80 {
	encode gzip

	# Los archivos con hash en el nombre (/assets/...) nunca cambian: se guardan un año.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Todo lo demás (index.html incluido) se revalida siempre, así un despliegue nuevo se ve de inmediato.
	@resto not path /assets/*
	header @resto Cache-Control "no-cache"

	# Todo lo que empiece con /api/ va al backend Spring Boot
	handle /api/* {
		reverse_proxy api:8080
	}

	# El resto es la app React; las rutas del navegador (/login, /curso/3...) vuelven a index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
